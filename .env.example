POSTGRES_PASSWORD=local_only_change_me
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
CORS_ORIGIN=http://localhost:8080,http://localhost:5173
DATABASE_SSL=false

# Chave do servidor do Firebase Cloud Messaging (Google) para notificações push
# Se vazia, o push opera em modo simulado (sem chamada externa)
FCM_SERVER_KEY=

# Azure Service Bus (mensageria da nuvem) - cadeia de conexão do namespace e nome da fila
# Se vazia, a mensageria opera com o barramento em processo (fallback local)
AZURE_SERVICE_BUS_CONNECTION_STRING=
AZURE_SERVICE_BUS_QUEUE=agendou-eventos
